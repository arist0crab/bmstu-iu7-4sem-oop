  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #0a0f0a;
    border: 1px solid #1a3b1a;
}

QMainWindow &gt; QWidget {
    background-color: #0a0f0a;
}

QFrame {
    background-color: #0c120c;
    border: 1px solid #1f4f1f;
    border-radius: 12px;
    padding: 8px;
    margin: 4px;
}

QGroupBox {
    background-color: #0c120c;
    border: 2px solid #1f6f1f;
    border-radius: 12px;
    margin-top: 14px;
    font-family: &quot;Courier New&quot;, &quot;Consolas&quot;, monospace;
    font-weight: bold;
    color: #2eff2e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px 0 8px;
    background-color: #0a0f0a;
    color: #4aff4a;
    font-weight: bold;
}

QTextEdit {
    background-color: #030603;
    color: #2eff2e;
    font-family: &quot;Courier New&quot;, &quot;Consolas&quot;, monospace;
    font-size: 12px;
    font-weight: 500;
    border: 2px solid #1f6f1f;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: #1f4f1f;
}

QTextEdit:focus {
    border: 2px solid #3eff3e;
    background-color: #050a05;
}

QPushButton {
    background-color: #0a120a;
    color: #2eff2e;
    font-family: &quot;Courier New&quot;, &quot;Consolas&quot;, monospace;
    font-weight: bold;
    font-size: 13px;
    border: 2px solid #1f6f1f;
    border-radius: 10px;
    padding: 8px 16px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #1a2a1a;
    border: 2px solid #3eff3e;
    color: #6aff6a;
}

QPushButton:pressed {
    background-color: #0a2a0a;
    border: 2px solid #1faf1f;
    color: #1fcf1f;
}

QPushButton:disabled {
    color: #1a4f1a;
    border-color: #1a4f1a;
    background-color: #060a06;
}

QLineEdit {
    background-color: #030603;
    color: #2eff2e;
    font-family: &quot;Courier New&quot;, &quot;Consolas&quot;, monospace;
    font-size: 12px;
    border: 2px solid #1f6f1f;
    border-radius: 10px;
    padding: 6px 10px;
    selection-background-color: #1f4f1f;
}

QLineEdit:focus {
    border: 2px solid #3eff3e;
    background-color: #050a05;
}

QLabel {
    color: #2eff2e;
    font-family: &quot;Courier New&quot;, &quot;Consolas&quot;, monospace;
    font-size: 15px;
    background-color: transparent;
}

QLabel[class=&quot;title&quot;] {
    font-size: 20px;
    font-weight: bold;
    color: #4aff4a;
    border-bottom: 2px solid #1f6f1f;
    padding-bottom: 6px;
}

QLabel[class=&quot;subtitle&quot;] {
    font-size: 14px;
    font-weight: bold;
    color: #3aff3a;
    padding: 4px 0;
}

QLabel[class=&quot;output&quot;] {
    background-color: #030603;
    border: 1px solid #1f4f1f;
    border-radius: 8px;
    padding: 6px;
    font-family: monospace;
}</string>
